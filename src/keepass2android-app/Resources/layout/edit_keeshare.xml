<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">
  <TextView
      android:text="@string/keeshare_type"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/keeshare_type_spinner"/>
  <Spinner
      android:id="@+id/keeshare_type_spinner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:entries="@array/keeshare_types"/>
  <TextView
      android:text="@string/keeshare_path_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/keeshare_path"/>
  <EditText
      android:id="@+id/keeshare_path"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textNoSuggestions"
      android:singleLine="true"/>
  <TextView
      android:text="@string/keeshare_password_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/keeshare_password"/>
  <EditText
      android:id="@+id/keeshare_password"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textPassword"
      android:singleLine="true"
      android:saveEnabled="false"/>
  <CheckBox
      android:id="@+id/keeshare_keep_groups"
      android:text="@string/keeshare_keep_groups_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <Button
      android:id="@+id/keeshare_pick_device_file"
      android:text="@string/keeshare_pick_device_file_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <TextView
      android:id="@+id/keeshare_device_file_label"
      android:text="@string/KeeShareLocationNotSet"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <CheckBox
      android:id="@+id/keeshare_remember_mount"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:checked="true"
      android:visibility="gone"/>
  <Button
      android:id="@+id/keeshare_clear_device_file"
      android:text="@string/keeshare_clear_device_file_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <Button
      android:id="@+id/keeshare_remove"
      android:text="@string/keeshare_remove_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <Button
      android:id="@+id/keeshare_save"
      android:text="@string/keeshare_save_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
