<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">
  <TextView
      android:id="@+id/keeshare_row_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="18sp"
      android:textStyle="bold"/>
  <TextView
      android:id="@+id/keeshare_row_type"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <TextView
      android:id="@+id/keeshare_row_location"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <TextView
      android:id="@+id/keeshare_row_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <Button
      android:id="@+id/keeshare_row_edit"
      android:text="@string/menu_edit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  <Button
      android:id="@+id/keeshare_row_sync"
      android:text="@string/keeshare_sync_now"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
</LinearLayout>
